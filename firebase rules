## Firestore

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUserDoc() {
      return userDoc(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(currentUserDoc())
        && get(currentUserDoc()).data.role == "admin";
    }

    function isDriver() {
      return isSignedIn()
        && exists(currentUserDoc())
        && get(currentUserDoc()).data.role == "driver";
    }

    function isPassenger() {
      return isSignedIn()
        && exists(currentUserDoc())
        && get(currentUserDoc()).data.role == "passenger";
    }

    function isValidRole(role) {
      return role in ["admin", "driver", "passenger"];
    }

    function isValidPassengerType(type) {
      return type == null || type in ["regular", "student"];
    }

    function protectedUserFieldsUnchanged() {
      return request.resource.data.user_id == resource.data.user_id
        && request.resource.data.role == resource.data.role
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isBanned == resource.data.isBanned
        && request.resource.data.created_at == resource.data.created_at;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.email == request.auth.token.email
        && isValidRole(request.resource.data.role)
        && request.resource.data.role != "admin"
        && isValidPassengerType(request.resource.data.passenger_type)
        && request.resource.data.isVerified == false
        && request.resource.data.isActive == false
        && request.resource.data.isBanned == false;

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && protectedUserFieldsUnchanged()
        );

      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      function isBookingParticipant() {
        return isSignedIn()
          && (
            resource.data.passenger_id == request.auth.uid
            || resource.data.driver_id == request.auth.uid
          );
      }

      allow create: if isSignedIn()
        && request.resource.data.passenger_id == request.auth.uid;

      allow get: if isAdmin() || isBookingParticipant();

      // Needed for queue / collection queries
      allow list: if isAdmin() || isSignedIn();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.passenger_id == request.auth.uid
            || resource.data.driver_id == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      function isRideParticipant() {
        return isSignedIn()
          && (
            resource.data.passenger_id == request.auth.uid
            || resource.data.driver_id == request.auth.uid
          );
      }

      allow create: if isSignedIn()
        && (
          request.resource.data.passenger_id == request.auth.uid
          || request.resource.data.driver_id == request.auth.uid
        );

      allow get: if isAdmin() || isRideParticipant();

      // Needed for collection queries
      allow list: if isAdmin() || isSignedIn();

      allow update: if isAdmin() || isRideParticipant();

      allow delete: if isAdmin();
    }
  }
}

## Storage rules
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(currentUserDoc())
        && firestore.get(currentUserDoc()).data.role == "admin";
    }

    function isImage() {
      return request.resource.contentType.matches("image/.*");
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();

      allow create, update: if isOwner(userId)
        && isImage()
        && request.resource.size < 5 * 1024 * 1024;

      allow delete: if isOwner(userId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
