rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole(userData) {
      return userData.get('role', '');
    }

    function isRegularAdminRole(userData) {
      return userRole(userData) in ['admin', 'Admin', 'ADMIN'];
    }

    function isSuperAdminRole(userData) {
      return userRole(userData) in [
        'super_admin',
        'Super Admin',
        'SUPER_ADMIN'
      ];
    }

    function isAdminRole(userData) {
      return isRegularAdminRole(userData) || isSuperAdminRole(userData);
    }

    function isPassengerRole(userData) {
      return userRole(userData) in [
        'passenger',
        'regular',
        'student',
        'senior_citizen',
        'Passenger',
        'Regular',
        'Student',
        'Senior Citizen',
        'PASSENGER',
        'REGULAR',
        'STUDENT',
        'SENIOR_CITIZEN'
      ];
    }

    function isDriverRole(userData) {
      return userRole(userData) in ['driver', 'Driver', 'DRIVER'];
    }

    function isVerifiedUser(userData) {
      return userData.get('is_verified', false) == true
        || userData.get('isVerified', false) == true
        || userData.get('isVerrified', false) == true;
    }

    function isNotBanned(userData) {
      return userData.get('is_banned', false) != true
        && userData.get('isBanned', false) != true;
    }

    function isNotDeactivated(userData) {
      return userData.get('is_deactivated', false) != true
        && userData.get('isDeactivated', false) != true
        && userData.get('account_status', 'active') != 'deactivated'
        && userData.get('account_status', 'active') != 'deleted';
    }

    function isUsableAccount(userData) {
      return isNotBanned(userData)
        && isNotDeactivated(userData);
    }

    function isActiveAccount(userData) {
      return userData.get('is_active', true) == true
        && isUsableAccount(userData);
    }

    function isAdmin() {
      return signedIn()
        && isAdminRole(signedInUser())
        && isActiveAccount(signedInUser());
    }

    function isSuperAdmin() {
      return signedIn()
        && isSuperAdminRole(signedInUser())
        && isActiveAccount(signedInUser());
    }

    function userById(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function userDocumentExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isActiveAdminId(userId) {
      return userDocumentExists(userId)
        && isAdminRole(userById(userId))
        && isActiveAccount(userById(userId));
    }

    function isVerifiedDriver() {
      return signedIn()
        && isDriverRole(signedInUser())
        && isVerifiedUser(signedInUser())
        && hasCurrentDriverDocuments(signedInUser())
        && isUsableAccount(signedInUser());
    }

    function hasCurrentDriverDocuments(userData) {
      return userData.get('document_status', 'valid') != 'expired'
        && (
          !userData.keys().hasAny(['drivers_license_expiry'])
          || (
            userData.drivers_license_expiry is timestamp
            && userData.drivers_license_expiry > request.time
          )
        )
        && (
          !userData.keys().hasAny(['or_cr_expiry'])
          || (
            userData.or_cr_expiry is timestamp
            && userData.or_cr_expiry > request.time
          )
        );
    }

    function isPublicVerifiedDriverProfile(userData) {
      return isDriverRole(userData)
        && isVerifiedUser(userData)
        && isNotBanned(userData)
        && isNotDeactivated(userData);
    }

    function isLeaderboardDriverProfile(userData) {
      return isDriverRole(userData)
        && isVerifiedUser(userData)
        && isNotBanned(userData);
    }

    function isCanonicalLeaderboardDriverProfile(userData) {
      return userData.role == 'driver'
        && userData.is_verified == true
        && userData.is_banned == false;
    }

    function isConversationParticipant(conversationData) {
      return signedIn()
        && request.auth.uid in conversationData.participant_ids;
    }

    function isSupportConversation(conversationData) {
      return conversationData.type == 'support';
    }

    function isAdminDirectConversation(conversationData) {
      return conversationData.type == 'admin_direct';
    }

    function isUserVisibleConversation(conversationData) {
      return conversationData.type in ['ride', 'support'];
    }

    function canReadConversation(conversationData) {
      return (
          isConversationParticipant(conversationData)
          && isUserVisibleConversation(conversationData)
        )
        || (isAdmin() && isSupportConversation(conversationData))
        || (
          isAdmin()
          && isAdminDirectConversation(conversationData)
          && request.auth.uid in conversationData.participant_ids
        );
    }

    function canWriteConversation(conversationData) {
      return (
          isConversationParticipant(conversationData)
          && isUserVisibleConversation(conversationData)
        )
        || (isAdmin() && isSupportConversation(conversationData))
        || (
          isAdmin()
          && isAdminDirectConversation(conversationData)
          && request.auth.uid in conversationData.participant_ids
        );
    }

    function isAdminCreatedSupportConversation(conversationId) {
      return isAdmin()
        && request.resource.data.type == 'support'
        && request.resource.data.support_user_id is string
        && request.resource.data.support_user_id.size() > 0
        && conversationId == 'support_' + request.resource.data.support_user_id
        && request.resource.data.participant_ids.size() == 1
        && request.resource.data.participant_ids[0] == request.resource.data.support_user_id
        && request.resource.data.participant_roles[request.resource.data.support_user_id] in [
          'driver',
          'passenger'
        ];
    }

    function hasStableConversationUpdate(conversationData) {
      return request.resource.data.conversation_id == conversationData.conversation_id
        && request.resource.data.type == conversationData.type
        && request.resource.data.participant_ids == conversationData.participant_ids
        && (
          !isAdminDirectConversation(conversationData)
          || (
            request.resource.data.participant_names == conversationData.participant_names
            && request.resource.data.participant_roles == conversationData.participant_roles
          )
        );
    }

    function ratingAggregateKeys() {
      return [
          'average_rating',
          'review_count',
          'review_rating_total',
          'driver_average_rating',
          'driver_review_count',
          'driver_review_rating_total',
          'driver_weighted_rating',
          'driver_rating_rank',
          'driver_rating_badge',
          'driver_rating_updated_at',
          'passenger_average_rating',
          'passenger_review_count',
          'passenger_review_rating_total'
        ];
    }

    function hasNoRatingAggregateChanges() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(ratingAggregateKeys());
    }

    function profilePictureKeys() {
      return [
        'profile_picture_url',
        'profile_picture_path',
        'profile_picture_updated_at',
        'profile_image_url',
        'profile_image_updated_at'
      ];
    }

    function profilePictureAllowedUpdateKeys() {
      return [
        'profile_picture_url',
        'profile_picture_path',
        'profile_picture_updated_at',
        'updated_at'
      ];
    }

    function hasProfilePictureChanges() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(profilePictureKeys());
    }

    function profilePictureCooldownPassed() {
      return (
          !resource.data.keys().hasAny(['profile_picture_updated_at'])
          || !(resource.data.profile_picture_updated_at is timestamp)
          || request.time >= resource.data.profile_picture_updated_at + duration.value(7, 'd')
        )
        && (
          !resource.data.keys().hasAny(['profile_image_updated_at'])
          || !(resource.data.profile_image_updated_at is timestamp)
          || request.time >= resource.data.profile_image_updated_at + duration.value(7, 'd')
        );
    }

    function isValidProfilePictureUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(profilePictureAllowedUpdateKeys())
        && request.resource.data.profile_picture_url is string
        && request.resource.data.profile_picture_url.size() > 0
        && request.resource.data.profile_picture_url.size() <= 2048
        && request.resource.data.profile_picture_path is string
        && request.resource.data.profile_picture_path.matches(
          'users/' + userId + '/profile_pictures/[^/]+'
        )
        && request.resource.data.profile_picture_updated_at is timestamp
        && request.resource.data.profile_picture_updated_at <= request.time
        && request.resource.data.updated_at is timestamp
        && request.resource.data.updated_at <= request.time
        && profilePictureCooldownPassed();
    }

    function isValidSelfProfileDetailsUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['age', 'gender', 'updated_at'])
        && request.resource.data.age is int
        && request.resource.data.age >= 13
        && request.resource.data.age <= 100
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.updated_at is timestamp
        && request.resource.data.updated_at <= request.time
        && hasNoRatingAggregateChanges();
    }

    function isValidDriverAvailabilityUpdate(userId) {
      return isSelf(userId)
        && isDriverRole(resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['is_active', 'updated_at'])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('is_verified', false) == resource.data.get('is_verified', false)
        && request.resource.data.get('is_banned', false) == resource.data.get('is_banned', false)
        && request.resource.data.get('is_deactivated', false) == resource.data.get('is_deactivated', false)
        && request.resource.data.get('account_status', 'active') == resource.data.get('account_status', 'active')
        && request.resource.data.is_active is bool
        && request.resource.data.updated_at == request.time
        && (
          request.resource.data.is_active == false
          || (
            isVerifiedUser(resource.data)
            && isUsableAccount(resource.data)
            && hasCurrentDriverDocuments(resource.data)
          )
        )
        && hasNoRatingAggregateChanges();
    }

    function isValidEmailVerificationUpdate(userId) {
      return isSelf(userId)
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['email', 'email_verified', 'email_verified_at', 'updated_at'])
        && request.auth.token.email is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email_verified == true
        && request.resource.data.email_verified_at == request.time
        && request.resource.data.updated_at == request.time
        && hasNoRatingAggregateChanges();
    }

    function isValidQuickDestinationsUpdate(userId) {
      return isSelf(userId)
        && isPassengerRole(resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'quick_destinations',
            'quick_destinations_updated_at'
          ])
        && request.resource.data.quick_destinations is list
        && request.resource.data.quick_destinations.size() <= 20
        && request.resource.data.quick_destinations_updated_at == request.time
        && hasNoRatingAggregateChanges();
    }

    function driverPayoutSyncAllowedKeys() {
      return [
        'accepts_online_payments',
        'online_payment_methods',
        'default_payout_account_id',
        'updated_at'
      ];
    }

    function hasValidOnlinePaymentMethods(paymentMethods) {
      return paymentMethods is list
        && paymentMethods.size() <= 3
        && paymentMethods.hasOnly(['gcash', 'maya', 'bank']);
    }

    function hasValidDefaultPayoutAccountId(userData) {
      return !userData.keys().hasAny(['default_payout_account_id'])
        || userData.default_payout_account_id == null
        || userData.default_payout_account_id is string;
    }

    function isValidDriverPayoutSyncUpdate(userId) {
      return isSelf(userId)
        && isDriverRole(resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(driverPayoutSyncAllowedKeys())
        && request.resource.data.accepts_online_payments is bool
        && hasValidOnlinePaymentMethods(
          request.resource.data.online_payment_methods
        )
        && hasValidDefaultPayoutAccountId(request.resource.data)
        && request.resource.data.updated_at == request.time;
    }

    function driverRenewalSubmissionFields() {
      return [
        'renewal_status',
        'renewal_document_type',
        'renewal_document_url',
        'renewal_document_path',
        'renewal_expiry',
        'renewal_submitted_at',
        'updated_at'
      ];
    }

    function driverDocumentAdminFields() {
      return [
        'nbi_clearance_url',
        'nbi_clearance_path',
        'drivers_license_url',
        'drivers_license_path',
        'drivers_license_expiry',
        'selfie_url',
        'selfie_path',
        'or_cr_url',
        'or_cr_path',
        'or_cr_expiry',
        'document_status',
        'document_status_updated_at',
        'document_upload_status',
        'document_upload_error',
        'credential_updated_at',
        'renewal_status',
        'renewal_document_type',
        'renewal_document_url',
        'renewal_document_path',
        'renewal_expiry',
        'renewal_submitted_at',
        'renewal_reviewed_at',
        'renewal_reviewed_by',
        'renewal_rejection_reason'
      ];
    }

    function hasNoProtectedDriverDocumentChanges() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(driverDocumentAdminFields());
    }

    function isValidDriverRenewalSubmission(userId) {
      return isSelf(userId)
        && isDriverRole(resource.data)
        && resource.data.get('renewal_status', 'none') != 'pending_renewal'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(driverRenewalSubmissionFields())
        && request.resource.data.renewal_status == 'pending_renewal'
        && request.resource.data.renewal_document_type in [
          'drivers_license',
          'or_cr'
        ]
        && request.resource.data.renewal_document_url is string
        && request.resource.data.renewal_document_url.size() > 0
        && request.resource.data.renewal_document_url.size() <= 2048
        && request.resource.data.renewal_document_path is string
        && request.resource.data.renewal_document_path.matches(
          'users/' + userId + '/renewals/[^/]+'
        )
        && request.resource.data.renewal_expiry is timestamp
        && request.resource.data.renewal_expiry > request.time
        && request.resource.data.renewal_submitted_at == request.time
        && request.resource.data.updated_at == request.time
        && hasNoRatingAggregateChanges();
    }

    function driverCredentialUpdateFields() {
      return [
        'nbi_clearance_url',
        'nbi_clearance_path',
        'drivers_license_url',
        'drivers_license_path',
        'drivers_license_expiry',
        'selfie_url',
        'selfie_path',
        'or_cr_url',
        'or_cr_path',
        'or_cr_expiry',
        'document_status',
        'document_status_updated_at',
        'document_upload_status',
        'document_upload_error',
        'credential_updated_at',
        'is_verified',
        'is_active',
        'updated_at'
      ];
    }

    function isValidCredentialImageChange(
      userId,
      affectedKeys,
      urlField,
      pathField,
      storageName
    ) {
      return !affectedKeys.hasAny([urlField, pathField])
        || (
          affectedKeys.hasAll([urlField, pathField])
          && request.resource.data[urlField] is string
          && request.resource.data[urlField].size() > 0
          && request.resource.data[urlField].size() <= 2048
          && request.resource.data[pathField] is string
          && request.resource.data[pathField].matches(
            'users/' + userId + '/credentials/' + storageName + '_[^/]+'
          )
        );
    }

    function isValidExpiringCredentialChange(
      userId,
      affectedKeys,
      urlField,
      pathField,
      expiryField,
      storageName
    ) {
      return !affectedKeys.hasAny([urlField, pathField, expiryField])
        || (
          request.resource.data[expiryField] is timestamp
          && request.resource.data[expiryField] > request.time
          && (
            (
              affectedKeys.hasAny([urlField, pathField])
              && isValidCredentialImageChange(
                userId,
                affectedKeys,
                urlField,
                pathField,
                storageName
              )
            )
            || (
              !affectedKeys.hasAny([urlField, pathField])
              && affectedKeys.hasAny([expiryField])
              && request.resource.data[urlField] is string
              && request.resource.data[urlField].size() > 0
            )
          )
        );
    }

    function isValidDriverCredentialUpdate(userId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let updatesExpiringDocument = affectedKeys.hasAny([
        'drivers_license_url',
        'drivers_license_path',
        'drivers_license_expiry',
        'or_cr_url',
        'or_cr_path',
        'or_cr_expiry'
      ]);
      return isSelf(userId)
        && isDriverRole(resource.data)
        && affectedKeys.hasOnly(driverCredentialUpdateFields())
        && affectedKeys.hasAny([
          'nbi_clearance_url',
          'drivers_license_url',
          'drivers_license_expiry',
          'selfie_url',
          'or_cr_url',
          'or_cr_expiry'
        ])
        && isValidCredentialImageChange(
          userId,
          affectedKeys,
          'nbi_clearance_url',
          'nbi_clearance_path',
          'nbi_clearance'
        )
        && isValidExpiringCredentialChange(
          userId,
          affectedKeys,
          'drivers_license_url',
          'drivers_license_path',
          'drivers_license_expiry',
          'drivers_license'
        )
        && isValidCredentialImageChange(
          userId,
          affectedKeys,
          'selfie_url',
          'selfie_path',
          'selfie'
        )
        && isValidExpiringCredentialChange(
          userId,
          affectedKeys,
          'or_cr_url',
          'or_cr_path',
          'or_cr_expiry',
          'or_cr'
        )
        && request.resource.data.document_upload_status == 'uploaded'
        && !request.resource.data.keys().hasAny(['document_upload_error'])
        && request.resource.data.credential_updated_at == request.time
        && request.resource.data.is_verified == false
        && request.resource.data.is_active == false
        && request.resource.data.updated_at == request.time
        && (
          (
            updatesExpiringDocument
            && request.resource.data.document_status == 'valid'
            && request.resource.data.document_status_updated_at == request.time
          )
          || (
            !updatesExpiringDocument
            && !affectedKeys.hasAny([
              'document_status',
              'document_status_updated_at'
            ])
          )
        )
        && hasNoRatingAggregateChanges();
    }

    function isValidInitialDriverDocumentUpload(userId) {
      return isSelf(userId)
        && isDriverRole(resource.data)
        && !isVerifiedUser(resource.data)
        && !resource.data.keys().hasAny([
          'drivers_license_url',
          'or_cr_url'
        ])
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'nbi_clearance_url',
            'drivers_license_url',
            'selfie_url',
            'or_cr_url',
            'tricycle_front_url',
            'tricycle_back_url',
            'document_upload_status',
            'document_upload_error'
          ])
        && request.resource.data.nbi_clearance_url is string
        && request.resource.data.drivers_license_url is string
        && request.resource.data.selfie_url is string
        && request.resource.data.or_cr_url is string
        && request.resource.data.tricycle_front_url is string
        && request.resource.data.tricycle_back_url is string
        && request.resource.data.document_upload_status == 'uploaded'
        && hasNoRatingAggregateChanges();
    }

    function payoutAccountOwnerId(accountData) {
      return accountData.get('driver_id', accountData.get('user_id', ''));
    }

    function isOwnedDriverPayoutAccount(accountData, userId) {
      return payoutAccountOwnerId(accountData) == userId;
    }

    function isValidPayoutDefaultToggle(userId) {
      return isSelf(userId)
        && isDriverRole(signedInUser())
        && isOwnedDriverPayoutAccount(resource.data, userId)
        && isOwnedDriverPayoutAccount(request.resource.data, userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['is_default', 'updated_at'])
        && request.resource.data.is_default is bool
        && request.resource.data.updated_at == request.time;
    }

    function reviewAllowedKeys() {
      return [
        'review_id',
        'booking_id',
        'reviewer_id',
        'reviewer_role',
        'reviewer_name',
        'reviewee_id',
        'reviewee_role',
        'rating',
        'comment',
        'created_at',
        'updated_at'
      ];
    }

    function hasBasicReviewShape(reviewId, reviewData) {
      return reviewData.keys().hasOnly(reviewAllowedKeys())
        && reviewData.review_id == reviewId
        && reviewData.booking_id is string
        && reviewData.reviewer_id is string
        && reviewData.reviewee_id is string
        && reviewData.reviewer_role in ['driver', 'passenger']
        && reviewData.reviewee_role in ['driver', 'passenger']
        && reviewData.rating is int
        && reviewData.rating >= 1
        && reviewData.rating <= 5;
    }

    function reviewBookingPath(reviewData) {
      return /databases/$(database)/documents/bookings/$(reviewData.booking_id);
    }

    function reviewBookingExists(reviewData) {
      return exists(reviewBookingPath(reviewData));
    }

    function reviewBooking(reviewData) {
      return get(reviewBookingPath(reviewData)).data;
    }

    function hasValidReviewDocumentId(reviewId, reviewData) {
      return (
          reviewData.reviewer_role == 'passenger'
          && reviewData.reviewee_role == 'driver'
          && reviewId == reviewData.booking_id
            + '_passenger_'
            + reviewData.reviewer_id
            + '_driver_'
            + reviewData.reviewee_id
        )
        || (
          reviewData.reviewer_role == 'driver'
          && reviewData.reviewee_role == 'passenger'
          && reviewId == reviewData.booking_id
            + '_driver_'
            + reviewData.reviewer_id
            + '_passenger_'
            + reviewData.reviewee_id
        );
    }

    function isPassengerDriverReview(reviewData) {
      return reviewData.reviewer_role == 'passenger'
        && reviewData.reviewee_role == 'driver'
        && reviewData.reviewer_id == request.auth.uid
        && reviewBookingExists(reviewData)
        && reviewBooking(reviewData).passenger_id == request.auth.uid
        && reviewBooking(reviewData).driver_id == reviewData.reviewee_id
        && reviewBooking(reviewData).status == 'completed'
        && !reviewBooking(reviewData).keys().hasAny(['passenger_driver_review']);
    }

    function isDriverPassengerReview(reviewData) {
      return reviewData.reviewer_role == 'driver'
        && reviewData.reviewee_role == 'passenger'
        && reviewData.reviewer_id == request.auth.uid
        && reviewBookingExists(reviewData)
        && reviewBooking(reviewData).driver_id == request.auth.uid
        && reviewBooking(reviewData).passenger_id == reviewData.reviewee_id
        && reviewBooking(reviewData).status == 'completed'
        && !reviewBooking(reviewData).keys().hasAny(['driver_passenger_review']);
    }

    function isValidRideReview(reviewId) {
      return signedIn()
        && hasBasicReviewShape(reviewId, request.resource.data)
        && hasValidReviewDocumentId(reviewId, request.resource.data)
        && (
          isPassengerDriverReview(request.resource.data)
          || isDriverPassengerReview(request.resource.data)
        );
    }

    function isValidSignup(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'user_id',
          'first_name',
          'last_name',
          'email',
          'role',
          'passenger_type',
          'vehicle_type',
          'tricycle_color',
          'plate_number',
          'drivers_license_expiry',
          'or_cr_expiry',
          'document_status',
          'renewal_status',
          'age',
          'gender',
          'is_verified',
          'is_active',
          'is_banned',
          'is_deactivated',
          'email_verified',
          'account_status',
          'created_at'
        ])
        && request.resource.data.user_id == userId
        && request.resource.data.email is string
        && request.resource.data.first_name is string
        && !request.resource.data.first_name.matches('^\\s*[Aa][Dd][Mm][Ii][Nn]\\s*$')
        && request.resource.data.last_name is string
        && request.resource.data.role in ['passenger', 'driver']
        && request.resource.data.is_verified == false
        && request.resource.data.is_active == false
        && request.resource.data.is_banned == false
        && request.resource.data.is_deactivated == false
        && request.resource.data.email_verified == false
        && request.resource.data.account_status == 'active'
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at <= request.time
        && (
          request.resource.data.role != 'passenger'
          || request.resource.data.passenger_type in ['regular', 'student', 'senior_citizen']
        )
        && (
          request.resource.data.role != 'driver'
          || (
            request.resource.data.vehicle_type is string
            && request.resource.data.vehicle_type.size() > 0
            && request.resource.data.tricycle_color is string
            && request.resource.data.tricycle_color.size() > 0
            && request.resource.data.plate_number is string
            && request.resource.data.plate_number.size() > 0
            && request.resource.data.drivers_license_expiry is timestamp
            && request.resource.data.drivers_license_expiry > request.time
            && request.resource.data.or_cr_expiry is timestamp
            && request.resource.data.or_cr_expiry > request.time
            && request.resource.data.document_status == 'valid'
            && request.resource.data.renewal_status == 'none'
          )
        )
        && (
          !request.resource.data.keys().hasAny(['age'])
          || request.resource.data.age is int
        )
        && (
          !request.resource.data.keys().hasAny(['gender'])
          || request.resource.data.gender in ['male', 'female', 'other']
        );
    }

    function isValidSelfDeactivation(userId) {
      return isSelf(userId)
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.is_verified == resource.data.is_verified
        && request.resource.data.is_banned == resource.data.is_banned
        && request.resource.data.is_active == false
        && request.resource.data.is_deactivated == true
        && request.resource.data.account_status == 'deactivated'
        && request.resource.data.deactivated_at == request.time
        && request.resource.data.updated_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'is_active',
          'is_deactivated',
          'account_status',
          'deactivated_at',
          'updated_at'
        ])
        && hasNoRatingAggregateChanges();
    }

    function fareSettingsAllowedKeys() {
      return [
        'currency',
        'one_barangay_fare',
        'buenavista_five_barangay_fare',
        'outside_buenavista_min_fare',
        'outside_buenavista_9km_fare',
        'outside_buenavista_12km_fare',
        'outside_buenavista_16km_fare',
        'outside_buenavista_max_fare',
        'regular_passenger_discount_rate',
        'student_discount_rate',
        'senior_citizen_discount_rate',
        'driver_pickup_surcharge_per_extra_barangay',
        'max_driver_pickup_surcharge',
        'commission_rate',
        'updated_by',
        'updated_at'
      ];
    }

    function isValidFareSettings(settingsData) {
      return settingsData.keys().hasOnly(fareSettingsAllowedKeys())
        && settingsData.currency == 'PHP'
        && settingsData.one_barangay_fare is int
        && settingsData.one_barangay_fare > 0
        && settingsData.buenavista_five_barangay_fare is int
        && settingsData.buenavista_five_barangay_fare >= settingsData.one_barangay_fare
        && settingsData.outside_buenavista_min_fare is int
        && settingsData.outside_buenavista_min_fare > 0
        && settingsData.outside_buenavista_9km_fare is int
        && settingsData.outside_buenavista_9km_fare >= settingsData.outside_buenavista_min_fare
        && settingsData.outside_buenavista_12km_fare is int
        && settingsData.outside_buenavista_12km_fare >= settingsData.outside_buenavista_9km_fare
        && settingsData.outside_buenavista_16km_fare is int
        && settingsData.outside_buenavista_16km_fare >= settingsData.outside_buenavista_12km_fare
        && settingsData.outside_buenavista_max_fare is int
        && settingsData.outside_buenavista_max_fare >= settingsData.outside_buenavista_16km_fare
        && settingsData.regular_passenger_discount_rate is number
        && settingsData.regular_passenger_discount_rate >= 0
        && settingsData.regular_passenger_discount_rate <= 1
        && settingsData.student_discount_rate is number
        && settingsData.student_discount_rate >= 0
        && settingsData.student_discount_rate <= 1
        && settingsData.senior_citizen_discount_rate is number
        && settingsData.senior_citizen_discount_rate >= 0
        && settingsData.senior_citizen_discount_rate <= 1
        && settingsData.driver_pickup_surcharge_per_extra_barangay is int
        && settingsData.driver_pickup_surcharge_per_extra_barangay >= 0
        && settingsData.max_driver_pickup_surcharge is int
        && (
          (settingsData.driver_pickup_surcharge_per_extra_barangay == 0
            && settingsData.max_driver_pickup_surcharge == 0)
          || (settingsData.driver_pickup_surcharge_per_extra_barangay > 0
            && settingsData.max_driver_pickup_surcharge >= settingsData.driver_pickup_surcharge_per_extra_barangay)
        )
        && settingsData.commission_rate is number
        && settingsData.commission_rate >= 0
        && settingsData.commission_rate <= 1
        && settingsData.updated_by == request.auth.uid
        && settingsData.updated_at == request.time;
    }

    function isOpenBookingQueueRecord(bookingData) {
      return bookingData.status in ['searching', 'pending', 'queued', 'new'];
    }

    function canReadBooking(bookingData) {
      return isAdmin()
        || (signedIn() && bookingData.passenger_id == request.auth.uid)
        || (signedIn() && bookingData.driver_id == request.auth.uid)
        || (isVerifiedDriver() && isOpenBookingQueueRecord(bookingData));
    }

    function pickupEtaKeys() {
      return [
        'driver_to_pickup_distance_meters',
        'driver_to_pickup_duration_seconds',
        'driver_to_pickup_distance_text',
        'driver_to_pickup_duration_text'
      ];
    }

    function pickupEtaUpdateKeys() {
      return [
        'driver_to_pickup_distance_meters',
        'driver_to_pickup_duration_seconds',
        'driver_to_pickup_distance_text',
        'driver_to_pickup_duration_text',
        'updated_at'
      ];
    }

    function remainingEtaKeys() {
      return [
        'remaining_ride_distance_meters',
        'remaining_ride_duration_seconds',
        'remaining_ride_distance_text',
        'remaining_ride_duration_text'
      ];
    }

    function remainingEtaUpdateKeys() {
      return [
        'remaining_ride_distance_meters',
        'remaining_ride_duration_seconds',
        'remaining_ride_distance_text',
        'remaining_ride_duration_text',
        'updated_at'
      ];
    }

    function etaKeys() {
      return [
        'driver_to_pickup_distance_meters',
        'driver_to_pickup_duration_seconds',
        'driver_to_pickup_distance_text',
        'driver_to_pickup_duration_text',
        'remaining_ride_distance_meters',
        'remaining_ride_duration_seconds',
        'remaining_ride_distance_text',
        'remaining_ride_duration_text',
        'updated_at'
      ];
    }

    function hasValidEtaShape(etaData) {
      return etaData is map
        && etaData.keys().hasOnly(etaKeys())
        && (
          !etaData.keys().hasAny(['driver_to_pickup_distance_meters'])
          || (
            etaData.driver_to_pickup_distance_meters is int
            && etaData.driver_to_pickup_distance_meters >= 0
          )
        )
        && (
          !etaData.keys().hasAny(['driver_to_pickup_duration_seconds'])
          || (
            etaData.driver_to_pickup_duration_seconds is int
            && etaData.driver_to_pickup_duration_seconds >= 0
          )
        )
        && (
          !etaData.keys().hasAny(['driver_to_pickup_distance_text'])
          || etaData.driver_to_pickup_distance_text is string
        )
        && (
          !etaData.keys().hasAny(['driver_to_pickup_duration_text'])
          || etaData.driver_to_pickup_duration_text is string
        )
        && (
          !etaData.keys().hasAny(['remaining_ride_distance_meters'])
          || (
            etaData.remaining_ride_distance_meters is int
            && etaData.remaining_ride_distance_meters >= 0
          )
        )
        && (
          !etaData.keys().hasAny(['remaining_ride_duration_seconds'])
          || (
            etaData.remaining_ride_duration_seconds is int
            && etaData.remaining_ride_duration_seconds >= 0
          )
        )
        && (
          !etaData.keys().hasAny(['remaining_ride_distance_text'])
          || etaData.remaining_ride_distance_text is string
        )
        && (
          !etaData.keys().hasAny(['remaining_ride_duration_text'])
          || etaData.remaining_ride_duration_text is string
        );
    }

    function hasNoEtaChanges() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['eta']);
    }

    function isValidDriverEtaUpdate() {
      return isVerifiedDriver()
        && resource.data.driver_id == request.auth.uid
        && request.resource.data.driver_id == resource.data.driver_id
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'eta',
          'updated_at'
        ])
        && request.resource.data.updated_at == request.time
        && hasValidEtaShape(request.resource.data.eta)
        && request.resource.data.eta.updated_at == request.time
        && (
          (
            resource.data.status in ['accepted', 'driver_arriving', 'arrived']
            && request.resource.data.eta.keys().hasAll(pickupEtaKeys())
            && request.resource.data.eta.diff(resource.data.get('eta', {}))
              .affectedKeys()
              .hasAny(pickupEtaKeys())
            && request.resource.data.eta.diff(resource.data.get('eta', {}))
              .affectedKeys()
              .hasOnly(pickupEtaUpdateKeys())
          )
          || (
            resource.data.status == 'in_progress'
            && request.resource.data.eta.keys().hasAll(remainingEtaKeys())
            && request.resource.data.eta.diff(resource.data.get('eta', {}))
              .affectedKeys()
              .hasAny(remainingEtaKeys())
            && request.resource.data.eta.diff(resource.data.get('eta', {}))
              .affectedKeys()
              .hasOnly(remainingEtaUpdateKeys())
          )
        );
    }

    function reportDocumentPath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId);
    }

    function isDailyReportDocumentId(reportId) {
      return reportId.matches('^daily_[0-9]{8}_[A-Za-z0-9_-]+_[A-Za-z0-9_-]+$');
    }

    function isMissingDailyReportProbe(reportId) {
      return signedIn()
        && isDailyReportDocumentId(reportId)
        && !exists(reportDocumentPath(reportId));
    }

    match /users/{userId} {
      allow create: if isValidSignup(userId);
      allow read: if isSelf(userId)
        || isAdmin()
        || (
          signedIn()
          && isCanonicalLeaderboardDriverProfile(resource.data)
        )
        || (
          signedIn()
          && isPublicVerifiedDriverProfile(resource.data)
        )
        || (
          signedIn()
          && isLeaderboardDriverProfile(resource.data)
        )
        || (
          signedIn()
          && isDriverRole(resource.data)
          && isVerifiedUser(resource.data)
          && isNotBanned(resource.data)
        )
        || (
            signedIn()
            && isPassengerRole(resource.data)
            && isVerifiedDriver()
        );
      allow update: if !isAdminRole(resource.data)
        && isValidSelfDeactivation(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidProfilePictureUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidSelfProfileDetailsUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidDriverAvailabilityUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidEmailVerificationUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidQuickDestinationsUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidDriverPayoutSyncUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidDriverRenewalSubmission(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidDriverCredentialUpdate(userId);
      allow update: if !isAdminRole(resource.data)
        && isValidInitialDriverDocumentUpload(userId);
      allow update: if !isAdminRole(resource.data)
        && isSelf(userId)
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.is_verified == resource.data.is_verified
        && request.resource.data.is_active == resource.data.is_active
        && request.resource.data.is_banned == resource.data.is_banned
        && request.resource.data.is_deactivated == resource.data.is_deactivated
        && request.resource.data.account_status == resource.data.account_status
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['email_verified', 'email_verified_at'])
        && (
          !isDriverRole(resource.data)
          || hasNoProtectedDriverDocumentChanges()
        )
        && hasNoRatingAggregateChanges()
        && (
          !hasProfilePictureChanges()
          || isValidProfilePictureUpdate(userId)
        );
      allow update, delete: if isAdmin() && !isAdminRole(resource.data);

      match /payment_methods/{methodId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
          && isPassengerRole(signedInUser())
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'card']
          && request.resource.data.provider == 'xendit'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string;
        allow update: if isSelf(userId)
          && isPassengerRole(signedInUser())
          && resource.data.user_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'card']
          && request.resource.data.provider == 'xendit';
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /payout_accounts/{accountId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
          && isDriverRole(signedInUser())
          && request.resource.data.driver_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'bank']
          && request.resource.data.provider == 'driver_payout'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string
          && request.resource.data.bank_name is string;
        allow update: if isValidPayoutDefaultToggle(userId);
        allow update: if isSelf(userId)
          && isDriverRole(signedInUser())
          && isOwnedDriverPayoutAccount(resource.data, userId)
          && request.resource.data.driver_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'bank']
          && request.resource.data.provider == 'driver_payout'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string
          && request.resource.data.bank_name is string;
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /fcm_tokens/{tokenId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isSelf(userId)
          && request.resource.data.user_id == userId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform is string;
        allow delete: if isSelf(userId) || isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if canReadBooking(resource.data);
      allow create: if signedIn()
        && request.resource.data.passenger_id == request.auth.uid;
      allow update: if (
          isAdmin()
          || isVerifiedDriver()
          || (signedIn() && resource.data.passenger_id == request.auth.uid)
        )
        && hasNoEtaChanges();
      allow update: if isValidDriverEtaUpdate();
      allow delete: if isAdmin();
    }

    match /fare_settings/{settingId} {
      allow read: if settingId == 'current';
      allow create, update: if settingId == 'current'
        && isAdmin()
        && isValidFareSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read, write: if signedIn();
    }

    match /driver_locations/{driverId} {
      allow read: if signedIn();
      allow create, update: if isSelf(driverId)
        && isDriverRole(signedInUser())
        && request.resource.data.driver_id == driverId
        && (
          request.resource.data.is_available != true
          || isVerifiedDriver()
        );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if isValidRideReview(reviewId)
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if false;
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'is_read',
          'read_at'
        ]);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isMissingDailyReportProbe(reportId);
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporter_id == request.auth.uid)
        || (signedIn() && resource.data.reported_user_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.reporter_role in ['driver', 'passenger']
        && request.resource.data.reported_user_role in ['driver', 'passenger']
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if canReadConversation(resource.data);
      allow create: if signedIn()
        && request.resource.data.conversation_id == conversationId
        && request.resource.data.type in ['ride', 'support']
        && request.resource.data.participant_ids is list
        && (
          (
            request.resource.data.type in ['ride', 'support']
            && request.auth.uid in request.resource.data.participant_ids
          )
          || isAdminCreatedSupportConversation(conversationId)
        );
      allow update: if canWriteConversation(resource.data)
        && hasStableConversationUpdate(resource.data);
      allow delete: if isAdmin()
        && (
          !isAdminDirectConversation(resource.data)
          || isConversationParticipant(resource.data)
        );

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if canReadConversation(parentConversation());
        allow create: if signedIn()
          && request.resource.data.message_id == messageId
          && request.resource.data.conversation_id == conversationId
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && canWriteConversation(parentConversation());
        allow update, delete: if isAdmin()
          && (
            !isAdminDirectConversation(parentConversation())
            || isConversationParticipant(parentConversation())
          );
      }
    }

    match /payment_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
