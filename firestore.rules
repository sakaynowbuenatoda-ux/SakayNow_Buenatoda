rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && signedInUser().role == 'admin';
    }

    function isPassengerRole(userData) {
      return userData.role in ['passenger', 'regular', 'student'];
    }

    function isDriverRole(userData) {
      return userData.role == 'driver';
    }

    function isVerifiedUser(userData) {
      return userData.is_verified == true
        || userData.isVerified == true
        || userData.isVerrified == true;
    }

    function isNotBanned(userData) {
      return userData.is_banned != true
        && userData.isBanned != true;
    }

    function isVerifiedDriver() {
      return signedIn()
        && signedInUser().role == 'driver'
        && isVerifiedUser(signedInUser())
        && isNotBanned(signedInUser());
    }

    function isConversationParticipant(conversationData) {
      return signedIn()
        && request.auth.uid in conversationData.participant_ids;
    }

    function isSupportConversation(conversationData) {
      return conversationData.type == 'support';
    }

    function canReadConversation(conversationData) {
      return isConversationParticipant(conversationData)
        || (isAdmin() && isSupportConversation(conversationData));
    }

    function canWriteConversation(conversationData) {
      return isConversationParticipant(conversationData)
        || (isAdmin() && isSupportConversation(conversationData));
    }

    function isRatingAggregateUpdate() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'average_rating',
          'review_count',
          'review_rating_total',
          'driver_average_rating',
          'driver_review_count',
          'driver_review_rating_total',
          'passenger_average_rating',
          'passenger_review_count',
          'updated_at'
        ]);
    }

    function isValidSignup(userId) {
      return isSelf(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.email is string
        && request.resource.data.first_name is string
        && request.resource.data.last_name is string
        && request.resource.data.role in ['passenger', 'driver']
        && request.resource.data.is_verified == false
        && request.resource.data.is_active == false
        && request.resource.data.is_banned == false
        && request.resource.data.created_at == request.time
        && (
          request.resource.data.role != 'passenger'
          || request.resource.data.passenger_type in ['regular', 'student']
        );
    }

    match /users/{userId} {
      allow create: if isValidSignup(userId);
      allow read: if isSelf(userId)
        || isAdmin()
        || (
          signedIn()
          && resource.data.role == 'driver'
          && isVerifiedUser(resource.data)
          && isNotBanned(resource.data)
        )
        || (
          signedIn()
          && resource.data.role == 'passenger'
          && isVerifiedDriver()
        );
      allow update: if isSelf(userId)
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.is_verified == resource.data.is_verified
        && request.resource.data.is_active == resource.data.is_active
        && request.resource.data.is_banned == resource.data.is_banned;
      allow update: if isRatingAggregateUpdate();
      allow update, delete: if isAdmin();

      match /payment_methods/{methodId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
          && isPassengerRole(signedInUser())
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'card']
          && request.resource.data.provider == 'paymongo'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string;
        allow update: if isSelf(userId)
          && isPassengerRole(signedInUser())
          && resource.data.user_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'card']
          && request.resource.data.provider == 'paymongo';
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /payout_accounts/{accountId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
          && isDriverRole(signedInUser())
          && request.resource.data.driver_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'bank']
          && request.resource.data.provider == 'driver_payout'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string
          && request.resource.data.bank_name is string;
        allow update: if isSelf(userId)
          && isDriverRole(signedInUser())
          && resource.data.driver_id == userId
          && request.resource.data.driver_id == userId
          && request.resource.data.user_id == userId
          && request.resource.data.type in ['gcash', 'maya', 'bank']
          && request.resource.data.provider == 'driver_payout'
          && request.resource.data.label is string
          && request.resource.data.account_name is string
          && request.resource.data.account_reference is string
          && request.resource.data.bank_name is string;
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /fcm_tokens/{tokenId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isSelf(userId)
          && request.resource.data.user_id == userId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform is string;
        allow delete: if isSelf(userId) || isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.passenger_id == request.auth.uid;
      allow update: if isAdmin()
        || isVerifiedDriver()
        || resource.data.passenger_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read, write: if signedIn();
    }

    match /driver_locations/{driverId} {
      allow read: if signedIn();
      allow create, update: if isSelf(driverId)
        && request.resource.data.driver_id == driverId
        && (
          request.resource.data.is_available != true
          || isVerifiedDriver()
        );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.reviewer_id == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewer_role in ['driver', 'passenger']
        && request.resource.data.reviewee_role in ['driver', 'passenger'];
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporter_id == request.auth.uid)
        || (signedIn() && resource.data.reported_user_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.reporter_role in ['driver', 'passenger']
        && request.resource.data.reported_user_role in ['driver', 'passenger']
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if canReadConversation(resource.data);
      allow create: if signedIn()
        && request.resource.data.conversation_id == conversationId
        && request.resource.data.type in ['ride', 'support']
        && request.resource.data.participant_ids is list
        && request.auth.uid in request.resource.data.participant_ids;
      allow update: if canWriteConversation(resource.data)
        && request.resource.data.conversation_id == resource.data.conversation_id
        && request.resource.data.type == resource.data.type
        && request.resource.data.participant_ids == resource.data.participant_ids;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if canReadConversation(parentConversation());
        allow create: if signedIn()
          && request.resource.data.message_id == messageId
          && request.resource.data.conversation_id == conversationId
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && canWriteConversation(parentConversation());
        allow update, delete: if isAdmin();
      }
    }

    match /payment_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
